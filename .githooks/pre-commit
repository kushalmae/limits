#!/bin/bash
#
# Pre-commit hook for Spacecraft Subsystem Limits
# Automatically builds dist/ folder when limits/ folder changes are committed
#

# Check if any files in limits/ folder are being committed
limits_changed=$(git diff --cached --name-only | grep "^limits/")

if [ -n "$limits_changed" ]; then
    echo "Building distribution files..."
    
    # Run the build script (suppress output unless there's an error)
    if python tools/build_master_limit_files_from_csvs.py; then
        # Check if dist files were generated/updated
        if [ -f "dist/master.csv" ] && [ -f "dist/latest.json" ] && [ -f "dist/manifest.json" ]; then
            # Temporarily unlock the files so git can stage them
            chmod +w dist/master.csv dist/latest.json dist/manifest.json 2>/dev/null || true
            
            # Add the updated dist files to the commit
            git add dist/master.csv dist/latest.json dist/manifest.json
            
            echo "Added dist files to commit"
        else
            echo "ERROR: Expected dist files were not generated"
            exit 1
        fi
    else
        echo "ERROR: Build script failed!"
        python tools/build_master_limit_files_from_csvs.py  # Show error output
        echo "Commit aborted. Please fix the issues and try again."
        exit 1
    fi
fi
